{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-pane",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PANE_LIVE",
        "class_name": "PaneLive"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pane-live-v1",
      "new_sqlite_classes": [
        "PaneLive"
      ]
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "",
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": ""
  }
}
